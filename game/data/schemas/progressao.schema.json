{
  "$comment": "Progressão do corte vertical (game/data/config/progressao.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["dinheiro_inicial", "reputacao", "bonus", "qualidade", "nivel_inicial", "motel", "carro", "loja", "melhorias"],
  "properties": {
    "$comment": {"type": "string"},
    "dinheiro_inicial": {"type": "integer", "minimum": 0},
    "reputacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["niveis", "caso_resolvido", "no_prazo", "sem_inocentes", "fracasso", "abandono", "inocente_prejudicado"],
      "properties": {
        "niveis": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["nome", "a_partir_de"], "properties": {"nome": {"type": "string"}, "a_partir_de": {"type": "integer"}}}
        },
        "caso_resolvido": {"type": "integer"},
        "no_prazo": {"type": "integer"},
        "sem_inocentes": {"type": "integer"},
        "fracasso": {"type": "integer"},
        "abandono": {"type": "integer"},
        "inocente_prejudicado": {"type": "integer"}
      }
    },
    "bonus": {
      "type": "object", "additionalProperties": false, "required": ["no_prazo", "sem_inocentes"],
      "properties": {"no_prazo": {"type": "number", "minimum": 0}, "sem_inocentes": {"type": "number", "minimum": 0}}
    },
    "qualidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["niveis", "armas", "mochila"],
      "properties": {
        "niveis": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "armas": {
          "type": "object", "additionalProperties": false, "required": ["dispersao", "recarga"],
          "properties": {
            "dispersao": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
            "recarga": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}}
          }
        },
        "mochila": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}}
      }
    },
    "nivel_inicial": {"$comment": "categoria -> nível 1 a 3", "type": "object"},
    "motel": {
      "type": "object", "additionalProperties": false, "required": ["diaria", "horas_de_sono", "guarda", "alcance", "abastece_ate_metros"],
      "properties": {
        "diaria": {"type": "integer", "minimum": 0},
        "horas_de_sono": {"type": "integer", "minimum": 1},
        "guarda": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "alcance": {"type": "number", "minimum": 0},
        "abastece_ate_metros": {"type": "number", "minimum": 0}
      }
    },
    "carro": {
      "type": "object", "additionalProperties": false,
      "required": ["tanque_litros", "litros_iniciais", "km_por_litro", "preco_do_litro", "velocidade_maxima", "re_maxima", "aceleracao", "freio", "giro", "alcance_da_porta", "viagem_rapida"],
      "properties": {
        "tanque_litros": {"type": "number", "minimum": 1},
        "litros_iniciais": {"type": "number", "minimum": 0},
        "km_por_litro": {"type": "number", "minimum": 0.1},
        "preco_do_litro": {"type": "integer", "minimum": 0},
        "velocidade_maxima": {"type": "number", "minimum": 0},
        "re_maxima": {"type": "number", "minimum": 0},
        "aceleracao": {"type": "number", "minimum": 0},
        "freio": {"type": "number", "minimum": 0},
        "giro": {"type": "number", "minimum": 0},
        "alcance_da_porta": {"type": "number", "minimum": 0},
        "viagem_rapida": {
          "$comment": "Dentro do carro, M abre o mapa de viagem rápida. O tempo e a gasolina saem da distância em linha reta vezes o desvio das ruas.",
          "type": "object", "additionalProperties": false, "required": ["velocidade_media_kmh", "desvio_das_ruas"],
          "properties": {"velocidade_media_kmh": {"type": "number", "minimum": 1}, "desvio_das_ruas": {"type": "number", "minimum": 1}}
        }
      }
    },
    "loja": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "nome", "item", "quantidade", "preco"],
        "properties": {"id": {"type": "string"}, "nome": {"type": "string"}, "item": {"type": "string"}, "quantidade": {"type": "integer", "minimum": 1}, "preco": {"type": "integer", "minimum": 0}}
      }
    },
    "melhorias": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "nome", "categoria", "nivel", "preco", "reputacao"],
        "properties": {"id": {"type": "string"}, "nome": {"type": "string"}, "categoria": {"type": "string"}, "nivel": {"type": "integer", "minimum": 1, "maximum": 3}, "preco": {"type": "integer", "minimum": 0}, "reputacao": {"type": "string"}}
      }
    }
  }
}
