{
  "$comment": "Bairro abstrato (docs/07). Validado por core/dados/esquema.gd.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome", "zona", "tipo", "populacao_alvo", "casas", "ruas", "comunidades", "locais"],
  "properties": {
    "$comment": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "nome": {"type": "string", "minLength": 1},
    "zona": {"enum": ["orla", "central_portuaria", "morros", "noroeste", "continental"]},
    "tipo": {"enum": ["mata", "residencial_denso", "centro", "antigo_religioso", "orla", "industrial", "subterraneo"]},
    "populacao_alvo": {"type": "integer", "minimum": 1, "maximum": 200},
    "casas": {"type": "integer", "minimum": 1, "maximum": 100},
    "ruas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "comunidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "peso"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "peso": {"type": "integer", "minimum": 1}
        }
      }
    },
    "locais": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tipo", "rua", "nome"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "tipo": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "rua": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "nome": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
