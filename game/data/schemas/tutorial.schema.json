{
  "$comment": "Caso tutorial com mentor (game/data/config/tutorial.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["especie", "teste", "mentor", "passos"],
  "properties": {
    "$comment": {"type": "string"},
    "especie": {"type": "string"},
    "teste": {"type": "string"},
    "mentor": {
      "type": "object", "additionalProperties": false, "required": ["idade", "comunidades", "jeitos", "apresentacao"],
      "properties": {
        "idade": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 18}},
        "comunidades": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "jeitos": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "apresentacao": {"type": "object"}
      }
    },
    "passos": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "objetivo", "fala"],
        "properties": {
          "id": {"enum": ["ir_ao_local", "anotar_pista", "ouvir_testemunha", "ligar", "teste_de_campo", "agir", "fim"]},
          "objetivo": {"type": "string"},
          "fala": {"type": "string"}
        }
      }
    }
  }
}
