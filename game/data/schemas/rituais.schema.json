{
  "$comment": "Rituais do confronto (game/data/config/rituais.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["janela_base", "janela_minima", "medo_encolhe_a_janela", "tremor_da_janela", "velocidade_do_marcador", "rituais"],
  "properties": {
    "$comment": {"type": "string"},
    "janela_base": {"type": "number", "minimum": 0, "maximum": 1},
    "janela_minima": {"type": "number", "minimum": 0, "maximum": 1},
    "medo_encolhe_a_janela": {"type": "number", "minimum": 0, "maximum": 1},
    "tremor_da_janela": {"type": "number", "minimum": 0, "maximum": 0.5},
    "velocidade_do_marcador": {"type": "number", "minimum": 0},
    "rituais": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "item", "exige_estado", "materiais", "passos"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "nome": {"type": "string", "minLength": 1},
          "item": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "exige_estado": {"enum": ["livre", "contida", "vulneravel"]},
          "materiais": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item", "quantidade"],
              "properties": {"item": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "quantidade": {"type": "integer", "minimum": 1}}
            }
          },
          "passos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tipo", "texto"],
              "properties": {
                "tipo": {"enum": ["apertar", "segurar", "palavra"]},
                "texto": {"type": "string", "minLength": 1},
                "opcoes": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
                "certa": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
