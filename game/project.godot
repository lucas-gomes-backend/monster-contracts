; Engine configuration file.
; Gerado à mão na Fase 0. O Godot pode reescrever este arquivo ao abrir o projeto.

config_version=5

[application]

config/name="Monster Contracts"
config/description="Investigação sobrenatural em Santos (SP), estética PS1."
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://ui/jogo.tscn"

[display]

; Resolução interna baixa, ampliada sem suavização (estética PS1, ver docs/09 e docs/10).
window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
